    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.19.19",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^26.1.0",
    "terser": "^5.51.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
