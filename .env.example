# Set to ambiten to persist through @ambiten/core + MongoDB.
# local is an explicit, single-process development adapter.
PURECONSENT_STORAGE=local
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=pureconsent
# Required for production and to enable operator login locally.
# Use a unique password of 16+ characters and a random 32+ character secret.
ADMIN_PASSWORD=
SESSION_SECRET=
APP_ORIGIN=http://localhost:3100
